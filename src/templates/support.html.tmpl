<!doctype html>
<html lang="{{@lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{supportPageTitle}}</title>
<meta name="description" content="{{supportMetaDescription}}">
<!-- seo:head --><!-- /seo:head -->
<link rel="stylesheet" href="{{@root}}style.css">{{@alternates}}
</head>
<body>
<header class="bar">
  <a class="wordmark" href="{{@langroot}}">Sorting&nbsp;Geography</a>
  <nav><a href="{{@langroot}}privacy/">{{navPrivacy}}</a> <a href="{{@root}}credits.html">{{navDataSources}}</a></nav>
</header>


<main class="prose">
  <h1>{{supportTitle}}</h1>
  <p class="lede">
    {{supportLede}}
  </p>

  <h2>{{supportContactTitle}}</h2>
  <p>
    {{supportContactText}}
  </p>
  <p>{{supportReportIntro}}</p>
  <ul>
    <li>{{supportReport1}}</li>
    <li>{{supportReport2}}</li>
    <li>{{supportReport3}}</li>
    <li>{{supportReport4}}</li>
  </ul>

  <h2>{{supportQuestionsTitle}}</h2>

  <h3>{{supportPlayTitle}}</h3>
  <p>
    {{supportPlayText}}
  </p>

  <h3>{{supportFreeTitle}}</h3>
  <!-- feature:support-free --><!-- /feature:support-free -->

  <h3>{{supportAccountTitle}}</h3>
  <p>{{supportAccountText}}</p>

  <h3>{{supportOfflineTitle}}</h3>
  <p>
    {{supportOfflineText}}
  </p>

  <h3>{{supportMoveTitle}}</h3>
  <p>
    {{supportMoveText}}
  </p>

  <!-- feature:support-unlock --><!-- /feature:support-unlock -->

  <h3>{{supportSourcesTitle}}</h3>
  <p>
    {{supportSourcesText}}
  </p>

  <h3>{{supportWrongTitle}}</h3>
  <p>
    {{supportWrongText}}
  </p>

  <h3>{{supportCollectTitle}}</h3>
  <p>
    {{supportCollectText}}
  </p>

  <!-- feature:support-analytics --><!-- /feature:support-analytics -->

  <h3>{{supportDeleteTitle}}</h3>
  <p>
    {{supportDeleteText}}
  </p>
</main>

<footer class="bar foot">
  <span>Sorting Geography</span>
  <nav><a href="{{@langroot}}support/">{{navSupport}}</a> <a href="{{@langroot}}privacy/">{{navPrivacy}}</a> <a href="{{@root}}terms/">{{navTerms}}</a> <a href="{{@root}}press/">{{navPress}}</a> <a href="{{@root}}credits.html">{{navDataSources}}</a></nav>
</footer>
</body>
</html>
