  "supportPlayTitle": "How do I play?",
  "@supportPlayTitle": {
    "description": "Question."
  },
  "supportPlayText": "Each puzzle shows five countries and one question, such as which has the longest coastline. Drag them into order, then confirm. Your score fills in on the same board, with the real numbers and any pairs you had the wrong way round.",
  "@supportPlayText": {
    "description": "Answer."
  },
  "supportFreeTitle": "Is it free?",
  "@supportFreeTitle": {
    "description": "Question."
  },
  "supportAccountTitle": "Do I need an account?",
  "@supportAccountTitle": {
    "description": "Question."
  },
  "supportAccountText": "No. Open the app and play. There is nothing to sign in to.",
  "@supportAccountText": {
    "description": "Answer."
  },
  "supportOfflineTitle": "Does it work offline?",
  "@supportOfflineTitle": {
    "description": "Question."
  },
  "supportOfflineText": "Yes. The countries, flags and numbers are all inside the app, so you can play without a connection.",
  "@supportOfflineText": {
    "description": "Answer."
  },
  "supportMoveTitle": "How do I move my progress to a new phone or tablet?",
  "@supportMoveTitle": {
    "description": "Question."
  },
  "supportMoveText": "Your progress is stored on your device, not on a server of ours, so it moves only with your device's own backup and restore through Google or iCloud. We cannot restore it for you, because we never have it.",
  "@supportMoveText": {
    "description": "Answer. Google before iCloud."
  },
  "supportSourcesTitle": "Where do the numbers come from?",
  "@supportSourcesTitle": {
    "description": "Question."
  },
  "supportSourcesText": "Every value comes from one named primary source, with its year and a link, shown in the game. The full list is on the <a href=\"credits.html\">data sources</a> page.",
  "@supportSourcesText": {
    "description": "Keep the link."
  },
  "supportWrongTitle": "I think a number is wrong",
  "@supportWrongTitle": {
    "description": "Question."
  },
  "supportWrongText": "Please tell us: email the country, the question, and what you think the figure should be, with a source if you have one, and we will check it against the source.",
  "@supportWrongText": {
    "description": "Answer."
  },
  "supportCollectTitle": "What does the app collect?",
  "@supportCollectTitle": {
    "description": "Question."
  },
  "supportCollectText": "Very little, and nothing that identifies you. The <a href=\"privacy/\">privacy page</a> says exactly what, including what Google's ad service receives.",
  "@supportCollectText": {
    "description": "Keep the link."
  },
  "supportDeleteTitle": "How do I delete my data?",
  "@supportDeleteTitle": {
    "description": "Question."
  },
  "supportDeleteText": "Delete the app. Everything the game keeps is on your device, and it goes with the app.",
  "@supportDeleteText": {
    "description": "Answer."
  },
